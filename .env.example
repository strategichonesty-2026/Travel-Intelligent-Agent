# Server
PORT=3100

# Optional — Recreation.gov RIDB API (federal campground search). Self-service signup:
# https://ridb.recreation.gov/landing/getting-started
RIDB_API_KEY=

# Optional — National Park Service API (park alerts/seasonal closures). Self-service signup:
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# Optional — Duffel (flights). Self-service signup: https://duffel.com
# Use a test token (starts "duffel_test_") for Duffel's test-mode data, or a live token once ready
# for real inventory — same base URL either way, the token itself determines the mode.
DUFFEL_ACCESS_TOKEN=

# Optional — Google Places API (New) (hotels/lodging — property name, location, rating, review
# count only; NO pricing/availability, see TECH_DECISION.md's Phase 4 addendum for why). Requires
# a Google Cloud project with billing enabled (a card on file, even to stay within free-tier
# usage) and "Places API (New)" enabled: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_PLACES_API_KEY=

# Optional — Outdoorsy Trailblazer Partner API (RV rental search), Flexible Getaway Finder
# Phase 2. Requires partner approval, not self-service — apply at developers.outdoorsy.com (free
# to apply, approval not guaranteed, and this is a business application this codebase can't
# submit on its own). Until approved, RV rental candidates stay deep-link-only.
ODC_PARTNER_ID=

# Optional — Vrbo "link-off" via Expedia Partner Solutions/Partnerize, Flexible Getaway Finder
# Phase 3. Requires approval + contracting with EPS/Vrbo/Partnerize, not self-service. Until
# approved, Vrbo candidates stay deep-link-only like every other unconfigured source.
VRBO_PARTNERIZE_ID=

# Real-money protection for live provider calls (Duffel/Google Places) — a hard, code-level cap
# independent of whatever quota is set on the provider's own dashboard. A repeat page load within
# the cache window reuses the last real response instead of calling the provider again; even a
# genuine cache miss stops calling once the weekly limit is hit. See src/services/liveDataCache.js
# and src/services/callBudget.js. All optional — sensible defaults apply if unset.
# LIVE_DATA_CACHE_TTL_HOURS=168
# MAX_FLIGHT_CALLS_PER_WEEK=50
# MAX_HOTEL_CALLS_PER_WEEK=50
