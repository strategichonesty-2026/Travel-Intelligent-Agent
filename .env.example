# Server
PORT=3100

# Optional — Recreation.gov RIDB API (federal campground search). Self-service signup:
# https://ridb.recreation.gov/landing/getting-started
RIDB_API_KEY=

# Optional — National Park Service API (park alerts/seasonal closures). Self-service signup:
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# Optional — Duffel (flights). Self-service signup: https://duffel.com
# Use a test token (starts "duffel_test_") for Duffel's test-mode data, or a live token once ready
# for real inventory — same base URL either way, the token itself determines the mode.
DUFFEL_ACCESS_TOKEN=

# Optional — Google Places API (New) (hotels/lodging — property name, location, rating, review
# count only; NO pricing/availability, see TECH_DECISION.md's Phase 4 addendum for why). Requires
# a Google Cloud project with billing enabled (a card on file, even to stay within free-tier
# usage) and "Places API (New)" enabled: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_PLACES_API_KEY=
